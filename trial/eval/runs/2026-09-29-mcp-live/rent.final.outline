app #n1 "Splitwise Home" phone
  screen #n2 "Home"
    row #n3 share=topbar justify=between pad=3 border
      shape #n5 circle w=28 h=28
    col #n6 pad=3 gap=3
      text #n4 "Maple House" bold size=xl
      button #n11 "Add expense" primary grow size=l
      row #n105 pad=3 border
        input #n106 "Search expenses" search w=fill
      col #n7 border pad=3 gap=1
        text #n8 "You are owed" size=s shade=mid
        text #n9 "$142.50" size=xxl bold
      row #n10 gap=2
      text #n13 "Recent activity" bold size=l
      col #n14 gap=2
        table #n150
          tr #n151 "Description | Paid by | Amount"
          tr #n152 "Electric bill | Dana · Feb 3 | +$38.20" data
          tr #n153 "Internet | You · Feb 2 | -$24.00" data
          tr #n154 "Costco run | Marcus · Jan 30 | +$61.75" data
          tr #n155 "Trash service | Dana · Jan 28 | +$12.00" data
      row #n156 pad=3 gap=2
        text #n157 "Filter" size=s shade=mid
        button #n158 "All expenses" ghost size=s
        button #n159 "You paid" ghost size=s
        button #n160 "You owe" ghost size=s
    row #n35 share=tabs justify=between pad=3 border fill=light
      text #n36 "Home" bold under
      text #n37 "Balances" shade=mid
      text #n38 "Groups" shade=mid
      text #n39 "Activity" shade=mid
  screen #n40 "Balances"
    row #n41 share=topbar justify=between pad=3 border
      text #n42 "Maple House" bold size=xl
      shape #n43 circle w=28 h=28
    col #n44 pad=3 gap=3
      text #n45 "Who owes what" bold size=l
      col #n46 border pad=3 gap=2
        row #n47 justify=between
          text #n48 "Dana Nguyen" bold
          text #n49 "owes you $56.20" size=s
        row #n50 justify=between
          text #n51 "Marcus Reid" bold
          text #n52 "owes you $86.30" size=s
        row #n53 justify=between
          text #n54 "You" bold
          text #n55 "owe Dana $0.00" size=s shade=mid
      line #n56
      text #n57 "By bill" bold
      table #n58
        tr #n59 "Bill | Total | Your share"
        tr #n60 "Rent | $2,400.00 | $800.00" data
        tr #n61 "Electric | $114.60 | $38.20" data
        tr #n62 "Internet | $72.00 | $24.00" data
        tr #n63 "Trash | $36.00 | $12.00" data
        tr #n64 "Groceries (shared) | $185.25 | $61.75" data
    row #n65 share=tabs justify=between pad=3 border fill=light
      text #n66 "Home" shade=mid
      text #n67 "Balances" bold under
      text #n68 "Groups" shade=mid
      text #n69 "Activity" shade=mid
  screen #n70 "Groups"
    row #n71 share=topbar justify=between pad=3 border
      text #n72 "Maple House" bold size=xl
      shape #n73 circle w=28 h=28
    col #n74 pad=3 gap=3
      text #n75 "Maple House" size=xl bold
      text #n76 "3 members · rent + utilities" size=s shade=mid
      row #n77 gap=2
        col #n78 border pad=2 align=center w=fill
          shape #n79 circle w=40 h=40
          text #n80 "Dana" size=s
        col #n81 border pad=2 align=center w=fill
          shape #n82 circle w=40 h=40
          text #n83 "Marcus" size=s
        col #n84 border pad=2 align=center w=fill
          shape #n85 circle w=40 h=40
          text #n86 "You" size=s bold
      line #n87
      text #n88 "Monthly recurring" bold
      col #n89 gap=2
        row #n90 border pad=2 justify=between
          text #n91 "Rent" bold
          text #n92 "$2,400.00" size=s
        row #n93 border pad=2 justify=between
          text #n94 "Electric (avg)" bold
          text #n95 "$110.00" size=s
        row #n96 border pad=2 justify=between
          text #n97 "Internet" bold
          text #n98 "$72.00" size=s
      button #n99 "Add roommate" ghost
    row #n100 share=tabs justify=between pad=3 border fill=light
      text #n101 "Home" shade=mid
      text #n102 "Balances" shade=mid
      text #n103 "Groups" bold under
      text #n104 "Activity" shade=mid
  screen #n107 "Settings"
    row #n108 share=topbar justify-between pad=3 border
      text #n109 "Maple House" bold size=xl
      shape #n110 circle w=28 h=28
    col #n111 pad=3 gap=3
      text #n112 "Settings" bold size=l
      col #n161 border pad=3 gap=2
        text #n162 "About this group" bold size=s shade=mid
        text #n163 "Shared house expenses for rent, utilities, and groceries. Settlement happens monthly." size=s shade=mid
      col #n113 border pad=3 gap=3
        text #n114 "Group" bold size=s shade=mid
        row #n115 justify=between align=center
          text #n116 "Group name"
          text #n117 "Maple House" size=s shade=mid
        row #n118 justify=between align=center
          text #n119 "Members"
          text #n120 "3" size=s shade=mid
        row #n121 justify=between align=center
          text #n122 "Currency"
          text #n123 "USD" size=s shade=mid
      col #n124 border pad=3 gap=3
        text #n125 "Notifications" bold size=s shade=mid
        row #n126 justify=between align=center
          text #n127 "Expense reminders"
          input #n128 toggle on
        row #n129 justify=between align=center
          text #n130 "Settlement alerts"
          input #n131 toggle on
        row #n132 justify=between align=center
          text #n133 "Weekly summary"
          input #n134 toggle
      col #n135 border pad=3 gap=3
        text #n136 "Preferences" bold size=s shade=mid
        row #n137 justify=between align=center
          text #n138 "Simplify debts"
          input #n139 toggle on
        row #n140 justify=between align=center
          text #n141 "Item-level detail"
          input #n142 toggle
      button #n143 "Leave group" ghost
    row #n144 share=tabs justify=between pad=3 border fill=light
      text #n145 "Home" shade=mid
      text #n146 "Balances" shade=mid
      text #n147 "Groups" shade=mid
      text #n148 "Activity" shade=mid
