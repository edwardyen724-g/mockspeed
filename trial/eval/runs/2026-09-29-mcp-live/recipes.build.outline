app #n1 "Recipe & Meal Planner" phone
  screen #n2 "Recipes"
    row #n3 share=topbar justify=between pad=3 border
      text #n4 "Recipes" bold size=l
      shape #n5 "search" w=20 h=20
    input #n6 "Search recipes" search value=chicken
    row #n7 gap=2
      text #n8 "All" bold under
      text #n9 "Breakfast" shade=mid
      text #n10 "Dinner" shade=mid
      text #n11 "Vegan" shade=mid
      text #n12 "Quick (<20m)" shade=mid
    grid #n13 cols=2 gap=3 pad=3
      col #n14 border pad=2 gap=1
        shape #n15 "recipe photo" w=fill h=90
        text #n16 "Miso Butter Salmon" bold
        text #n17 "25 min · 480 cal" size=s shade=mid
      col #n18 border pad=2 gap=1
        shape #n19 "recipe photo" w=fill h=90
        text #n20 "Chickpea Tikka Masala" bold
        text #n21 "35 min · 410 cal" size=s shade=mid
      col #n22 border pad=2 gap=1
        shape #n23 "recipe photo" w=fill h=90
        text #n24 "Overnight Oats" bold
        text #n25 "5 min · 320 cal" size=s shade=mid
      col #n26 border pad=2 gap=1
        shape #n27 "recipe photo" w=fill h=90
        text #n28 "Spatchcock Roast Chicken" bold
        text #n29 "1 hr 15 min · 610 cal" size=s shade=mid
    row #n30 share=tabs justify=between pad=3 border
      text #n31 "Recipes" bold
      text #n32 "Planner" shade=mid
      text #n33 "Groceries" shade=mid
      text #n34 "Saved" shade=mid
  screen #n35 "Planner"
    row #n36 share=topbar justify=between pad=3 border
      text #n37 "This Week" bold size=l
      text #n38 "Oct 14–20" size=s shade=mid
    col #n39 gap=2 pad=3
      row #n40 border pad=2 justify=between
        col #n41
          text #n42 "Monday" bold
          text #n43 "Overnight Oats" size=s shade=mid
          text #n44 "Chickpea Tikka Masala" size=s shade=mid
        text #n45 "2" size=xl shade=light
      row #n46 border pad=2 justify=between
        col #n47
          text #n48 "Tuesday" bold
          text #n49 "Miso Butter Salmon" size=s shade=mid
        text #n50 "1" size=xl shade=light
      row #n51 border pad=2 justify=between
        col #n52
          text #n53 "Wednesday" bold
          text #n54 "No meals planned" size=s shade=mid
        text #n55 "0" size=xl shade=light
      row #n56 border pad=2 justify=between
        col #n57
          text #n58 "Thursday" bold
          text #n59 "Spatchcock Roast Chicken" size=s shade=mid
          text #n60 "Overnight Oats" size=s shade=mid
        text #n61 "2" size=xl shade=light
      row #n62 border pad=2 justify=between
        col #n63
          text #n64 "Friday" bold
          text #n65 "Chickpea Tikka Masala" size=s shade=mid
        text #n66 "1" size=xl shade=light
    button #n67 "Add meal to day" primary
    row #n68 share=tabs justify=between pad=3 border
      text #n69 "Recipes" shade=mid
      text #n70 "Planner" bold
      text #n71 "Groceries" shade=mid
      text #n72 "Saved" shade=mid
  screen #n73 "Groceries"
    row #n74 share=topbar justify=between pad=3 border
      text #n75 "Groceries" bold size=l
      text #n76 "Clear checked" size=s shade=mid
    text #n77 "Generated from 6 planned meals" size=s shade=mid pad=3
    col #n78 gap=1 pad=3
      text #n79 "Produce" bold shade=mid
      input #n80 "Yellow onion (3)" check
      input #n81 "Garlic (1 head)" check
      input #n82 "Cilantro (1 bunch)" check on
      line #n83
      text #n84 "Protein" bold shade=mid
      input #n85 "Salmon fillets (4)" check
      input #n86 "Whole chicken (1)" check
      input #n87 "Chickpeas, canned (3)" check on
      line #n88
      text #n89 "Pantry" bold shade=mid
      input #n90 "Miso paste" check
      input #n91 "Rolled oats" check
      input #n92 "Garam masala" check
    row #n93 share=tabs justify=between pad=3 border
      text #n94 "Recipes" shade=mid
      text #n95 "Planner" shade=mid
      text #n96 "Groceries" bold
      text #n97 "Saved" shade=mid
