app #n1 "Summarize" panel
  screen #n2 "Summary" fill=light
    text #n4 "Page Summary" size=xl bold
    col #n21 pad=3 gap=2
      input #n22 "Search summaries..." w=fill
      line #n23
    col #n3 pad=3 gap=3
      text #n5 "www.example.com/article" shade=mid size=s
      col #n6 border pad=3 gap=2 fill=light
        text #n7 "This article explores how modern AI systems are trained using reinforcement learning from human feedback. It discusses the techniques OpenAI used to develop GPT-4, including constitutional AI methods and safety considerations. The piece covers practical applications in customer service and content creation, with examples from real companies implementing these systems in production." size=s
      row #n8 gap=2 pad=3 justify=between align=center
        text #n9 "2 min read" shade=mid size=s
      col #n11 gap=1 pad=3 border
        text #n54 "Key points" size=s bold shade=dark
        table #n55
          tr #n56 "Point | Impact"
          tr #n57 "RLHF improves model alignment" data
          tr #n58 "Constitutional AI reduces bias" data
          tr #n59 "Enterprise adoption growing 40% YoY" data
      col #n16 gap=2 pad=3
        text #n17 "Questions" size=s bold shade=dark
        text #n18 "What is reinforcement learning?" size=xs shade=mid
        text #n19 "How does constitutional AI work?" size=xs shade=mid
        text #n20 "What are real-world applications?" size=xs shade=mid
  screen #n24 "Settings"
    button #n51 "Clear cache" ghost w=fill
    col #n25 pad=3 gap=3
      text #n26 "Settings" size=xl bold
      line #n27
      col #n28 gap=2
        text #n29 "Display" size=s bold shade=dark
        row #n30 pad=2 justify=between align=center
          text #n31 "Dark mode" size=s
          shape #n32 "toggle" circle w=12 h=12 fill=mid
        row #n33 pad=2 justify=between align=center
          text #n34 "Font size" size=s
          text #n35 "Medium" size=xs shade=mid
      line #n36
      col #n37 gap=2
        text #n38 "Preferences" size=s bold shade=dark
        row #n39 pad=2 justify=between align=center
          text #n40 "Auto-summarize on load" size=s
          shape #n41 "toggle" circle w=12 h=12 fill=dark
        row #n42 pad=2 justify=between align=center
          text #n43 "Show key points" size=s
          shape #n44 "toggle" circle w=12 h=12 fill=dark
        row #n45 pad=2 justify=between align=center
          text #n46 "Generate questions" size=s
          shape #n47 "toggle" circle w=12 h=12 fill=mid
      line #n48
      col #n49 gap=2
        text #n50 "Data" size=s bold shade=dark
        button #n52 "Export summaries" ghost w=fill
