app #n1 "Splitwise" phone
  screen #n2 "Home"
    row #n3 h=60 pad=3 gap=2 fill=light align=center
      text #n4 "Splitwise" bold size=l
    col #n5 grow pad=3 gap=3
      col #n6 gap=1
        text #n7 "You are owed" size=s shade=mid
        text #n8 "$340.50" bold size=xl
      col #n9 gap=1
        text #n10 "You owe" size=s shade=mid
        text #n11 "$125.00" bold size=xl
      line #n12
      col #n13 gap=2
        col #n14 border pad=2 gap=1
          row #n15 justify=between align=center
            text #n16 "Alex paid $800 rent" bold
            text #n17 "Nov 10" size=s shade=mid data
          text #n18 "You owe $200" shade=mid
        col #n19 border pad=2 gap=1
          row #n20 justify=between align=center
            text #n21 "You paid $85 utilities" bold
            text #n22 "Nov 8" size=s shade=mid data
          text #n23 "Jamie owes you $42.50" shade=mid
        col #n24 border pad=2 gap=1
          row #n25 justify=between align=center
            text #n26 "Sam paid $120 groceries" bold
            text #n27 "Nov 5" size=s shade=mid data
          text #n28 "You owe $40" shade=mid
      col #n29 grow
      row #n30 gap=2 pad=3 border
        button #n31 "Add expense" primary w=fill
        button #n32 "Settle up" w=fill
  screen #n33 "Add Expense"
    row #n34 h=60 pad=3 gap=2 fill=light align=center
      text #n35 "← Home" size=s on
      text #n36 "New expense" bold size=l grow justify=center
    col #n37 grow pad=3 gap=3
      input #n38 "Paid by" value=You on
      input #n39 "Amount" value=$ on
      input #n40 "For what" value="" on
      col #n41 gap=2
        text #n42 "Who paid?" size=s shade=mid
        text #n43 "You" bold
        text #n44 "Alex" on
        text #n45 "Jamie" on
        text #n46 "Sam" on
      col #n47 gap=2
        text #n48 "Split among" size=s shade=mid
        text #n49 "You" check
        text #n50 "Alex" check
        text #n51 "Jamie" check
        text #n52 "Sam" check
      col #n53 grow
      button #n54 "Save" primary w=fill
  screen #n55 "Settle Up"
    row #n56 h=60 pad=3 gap=2 fill=light align=center
      text #n57 "← Home" size=s on
      text #n58 "Settle up" bold size=l grow justify=center
    col #n59 grow pad=3 gap=3
      col #n60 gap=2
        text #n61 "Simple payments" size=s shade=mid bold
        col #n62 gap=2
          col #n63 border pad=2 gap=1
            text #n64 "You pay Alex $200" bold
            button #n65 "Mark paid" ghost w=fill
          col #n66 border pad=2 gap=1
            text #n67 "Jamie pays you $42.50" bold
            button #n68 "Mark paid" ghost w=fill
          col #n69 border pad=2 gap=1
            text #n70 "You pay Sam $40" bold
            button #n71 "Mark paid" ghost w=fill
