                text #n30 "Brand guidelines" bold size=s
                text #n31 "Color + typography" size=xs shade=mid data
                text #n32 "Unassigned" size=xs shade=mid data
          col #n33 w=280 gap=2
            text #n34 "In Progress" bold size=m
            col #n35 gap=2
              col #n36 border pad=2 gap=1 fill=light
                text #n37 "Mobile app UI kit" bold size=s
                text #n38 "Components library" size=xs shade=mid data
                text #n39 "Jordan" size=xs shade=mid data
                text #n40 "Started Mon" size=xs shade=mid data
              col #n41 border pad=2 gap=1 fill=light
                text #n42 "Packaging design" bold size=s
                text #n43 "Label iteration 2" size=xs shade=mid data
                text #n44 "Maya" size=xs shade=mid data
                text #n45 "Started Wed" size=xs shade=mid data
          col #n46 w=280 gap=2
