app #n1 "Studio Board" web
  screen #n2 "Backlog"
    row #n3 h=fill
      col #n4 share=nav w=200 fill=mid pad=3 gap=2
        text #n5 "Studio Board" bold
        text #n6 "Backlog" bold
        text #n7 "Active" shade=mid
        text #n8 "Done" shade=mid
      col #n9 grow pad=4 gap=3
        row #n190 pad=4 gap=2 align=center
          input #n191 "Search tasks..." w=fill on
        row #n192 justify=between align=center
          text #n193 "Backlog" size=xxl bold
        table #n194
          tr #n195 "Task | Client | Assigned | Due"
          tr #n196 "Homepage Redesign | Acme Corp | Maya Chen | Jan 15" data
          tr #n197 "Logo Concepts | Internal | Jordan Lee | —" data
          tr #n198 "Brand Guidelines | Stellar Inc | Alex Rivera | Feb 3" data
          tr #n199 "Email Templates | Internal | — | —" data
          tr #n200 "Packaging Design | Fresh Foods | Maya Chen | Jan 22" data
        row #n201 pad=4 gap=2 align=center
          input #n202 "Filter by..." select w=200 on
          text #n203 "All Statuses" size=s shade=mid
  screen #n47 "Active"
    row #n48 h=fill
      col #n49 share=nav w=200 fill=mid pad=3 gap=2
        text #n50 "Studio Board" bold
        text #n51 "Backlog" shade=mid
        text #n52 "Active" bold
        text #n53 "Done" shade=mid
      col #n54 grow pad=4 gap=3
        text #n55 "In Progress" size=l bold
        row #n56 gap=4 h=fill
          col #n57 w=280 gap=2 fill=light pad=3 border
            text #n58 "In Progress" size=s bold shade=mid
            col #n59 border pad=3 gap=2 fill=dark
              text #n60 "Homepage Redesign" bold size=m
              text #n61 "Client: Acme Corp" size=s shade=light data
              row #n62 gap=1
                shape #n63 circle w=24 h=24
                text #n64 "Maya Chen" size=s shade=light data
              progress #n65 value=60
          col #n66 w=280 gap=2
            col #n67 border pad=3 gap=2
              text #n68 "Logo Concepts" bold size=m
              text #n69 "Internal" size=s shade=mid data
              row #n70 gap=1
                shape #n71 circle w=24 h=24
                text #n72 "Jordan Lee" size=s data
              text #n73 "Started Jan 8" size=xs shade=mid data
            col #n74 border pad=3 gap=2
              text #n75 "Brand Guidelines" bold size=m
              text #n76 "Client: Stellar Inc" size=s shade=mid data
              row #n77 gap=1
                shape #n78 circle w=24 h=24
                text #n79 "Alex Rivera" size=s data
              text #n80 "Review pending" size=xs shade=mid data
          col #n81 w=280 gap=2
            col #n82 border pad=3 gap=2
              text #n83 "Packaging Design" bold size=m
              text #n84 "Client: Fresh Foods" size=s shade=mid data
              row #n85 gap=1
                shape #n86 circle w=24 h=24
                text #n87 "Maya Chen" size=s data
              text #n88 "Blocked" size=xs shade=mid data
  screen #n89 "Done"
    row #n90 h=fill
      col #n91 share=nav w=200 fill=mid pad=3 gap=2
        text #n92 "Studio Board" bold
        text #n93 "Backlog" shade=mid
        text #n94 "Active" shade=mid
        text #n95 "Done" bold
      col #n96 grow pad=4 gap=3
        text #n97 "Completed" size=l bold
        row #n98 gap=4 h=fill
          col #n99 w=280 gap=2
            col #n100 border pad=3 gap=2
              text #n101 "Social Media Kit" bold size=m
              text #n102 "Client: Luna Wellness" size=s shade=mid data
              row #n103 gap=1
                shape #n104 circle w=24 h=24
                text #n105 "Jordan Lee" size=s data
              text #n106 "Finished Dec 18" size=xs shade=mid data
            col #n107 border pad=3 gap=2
              text #n108 "Event Poster Series" bold size=m
              text #n109 "Internal" size=s shade=mid data
              row #n110 gap=1
                shape #n111 circle w=24 h=24
                text #n112 "Alex Rivera" size=s data
              text #n113 "Finished Dec 22" size=xs shade=mid data
          col #n114 w=280 gap=2
            col #n115 border pad=3 gap=2
              text #n116 "Website Mockups" bold size=m
              text #n117 "Client: Acme Corp" size=s shade=mid data
              row #n118 gap=1
                shape #n119 circle w=24 h=24
                text #n120 "Maya Chen" size=s data
              text #n121 "Finished Jan 5" size=xs shade=mid data
            col #n122 border pad=3 gap=2
              text #n123 "Presentation Deck" bold size=m
              text #n124 "Client: Stellar Inc" size=s shade=mid data
              row #n125 gap=1
                shape #n126 circle w=24 h=24
                text #n127 "Alex Rivera" size=s data
              text #n128 "Finished Jan 10" size=xs shade=mid data
          col #n129 w=280 gap=2
            col #n130 border pad=3 gap=2
              text #n131 "Typography Study" bold size=m
              text #n132 "Internal" size=s shade=mid data
              row #n133 gap=1
                shape #n134 circle w=24 h=24
                text #n135 "Jordan Lee" size=s data
              text #n136 "Finished Jan 12" size=xs shade=mid data
  screen #n139 "Settings"
    row #n140 h=fill
      col #n141 share=nav w=200 fill=mid pad=3 gap=2
        text #n142 "Studio Board" bold
        text #n143 "Backlog" shade=mid
        text #n144 "Active" shade=mid
        text #n145 "Done" shade=mid
        text #n146 "Settings" bold
      col #n147 grow pad=4 gap=4
        text #n148 "Settings" size=xl bold
        col #n204 gap=2
          text #n205 "Notes" bold size=m
          col #n206 border pad=3 gap=2
            text #n207 "Last updated Jan 15 by Maya Chen" size=xs shade=mid data
            text #n208 "Team is on track for Q1 deliverables. Packaging design needs client feedback by Jan 20." size=s
        col #n149 gap=3
          col #n150 gap=2
            text #n151 "Team Members" bold size=m
            col #n152 border pad=3 gap=3
              row #n153 justify=between align=center
                col #n154 gap=1
                  text #n155 "Maya Chen" bold size=s data
                  text #n156 "maya@studiostudio.com" size=xs shade=mid data
                text #n157 "Admin" size=xs shade=mid data
              row #n158 justify=between align=center
                col #n159 gap=1
                  text #n160 "Jordan Lee" bold size=s data
                  text #n161 "jordan@studiostudio.com" size=xs shade=mid data
                text #n162 "Member" size=xs shade=mid data
              row #n163 justify=between align=center
                col #n164 gap=1
                  text #n165 "Alex Rivera" bold size=s data
                  text #n166 "alex@studiostudio.com" size=xs shade=mid data
                text #n167 "Member" size=xs shade=mid data
          col #n168 gap=2
            text #n169 "Workspace" bold size=m
            col #n170 border pad=3 gap=2
              row #n171 justify=between align=center
                text #n172 "Workspace Name"
                input #n173 value="Studio Board" w=200 on
              row #n174 justify=between align=center
                text #n175 "Default View"
                input #n176 select w=200 on
          col #n177 gap=2
            text #n178 "Notifications" bold size=m
            col #n179 border pad=3 gap=2
              row #n180 justify=between align=center
                text #n181 "Email on task assignment"
                input #n182 toggle on
              row #n183 justify=between align=center
                text #n184 "Email on project update"
                input #n185 toggle on
              row #n186 justify=between align=center
                text #n187 "Daily digest"
                input #n188 toggle on
