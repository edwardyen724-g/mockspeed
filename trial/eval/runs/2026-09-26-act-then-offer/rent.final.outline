app #n1 "SplitMate" phone
  screen #n2 "Home"
    row #n3 h=56 pad=2 border
      text #n4 "SplitMate" bold size=xxl
    col #n5 grow pad=3 gap=3
      button #n144 "Filter" ghost
      row #n96 gap=2 align=center pad=3 border
        input #n97 "Search expenses" search
        button #n98 "Filter" ghost
      col #n6 border pad=3 gap=2 fill=light
        text #n7 "Next payment due" shade=mid size=s
        text #n8 "Mar 15" bold size=l
        text #n9 "$340 from you" size=m
      col #n10 gap=2
        text #n11 "Active expenses" bold size=m
        col #n12
          table #n139
            tr #n140 "Expense | Due | Amount | People"
            tr #n141 "Rent | Mar 1 | $1200 | 4 people" data
            tr #n142 "Utilities | Feb 28 | $84 | 3 people" data
            tr #n143 "Groceries | Yesterday | $32.50 | 2 people" data
      button #n22 "Add expense" primary size=l
    row #n23 h=56 pad=3 justify=between border fill=light
      text #n24 "Home" bold size=s
      text #n25 "Expenses" shade=mid size=s
      text #n26 "People" shade=mid size=s
      text #n27 "Settings" shade=mid size=s
  screen #n28 "Expenses"
    row #n29 h=56 pad=2 border
      text #n30 "Expenses" bold size=l
    col #n31 grow pad=3 gap=2
      row #n32 gap=2 align=center
        input #n33 "Search" search
        button #n34 "Filter" ghost
      col #n35 gap=2
        col #n36 border pad=2 gap=1
          row #n37 justify=between
            col #n38 gap=1
              text #n39 "Rent" bold
              text #n40 "Added by Alex" shade=mid size=xs
            text #n41 "$1200" bold
          text #n42 "You pay $300" size=s shade=dark
        col #n43 border pad=2 gap=1
          row #n44 justify=between
            col #n45 gap=1
              text #n46 "Groceries" bold
              text #n47 "Added by Jordan" shade=mid size=xs
            text #n48 "$32.50" bold
          text #n49 "You're owed $5.83" size=s shade=dark
        col #n50 border pad=2 gap=1
          row #n51 justify=between
            col #n52 gap=1
              text #n53 "Coffee run" bold
              text #n54 "Added by Sam" shade=mid size=xs
            text #n55 "$12" bold
          text #n56 "You pay $4" size=s shade=dark
      button #n57 "Add expense" primary
    row #n58 h=56 pad=3 justify=between border
      text #n59 "Home" shade=mid size=s
      text #n60 "Expenses" bold size=s
      text #n61 "People" shade=mid size=s
      text #n62 "Settings" shade=mid size=s
  screen #n63 "People"
    row #n64 h=56 pad=2 border
      text #n65 "Roommates" bold size=l
    col #n66 grow pad=3 gap=3
      col #n67 gap=2
        text #n68 "Total owed to you" shade=mid size=s
        text #n69 "$8.17" bold size=xl
      col #n70 gap=2
        text #n71 "Balances" bold size=m
        col #n72 gap=2
          row #n73 justify=between align=center
            col #n74 gap=1
              text #n75 "Alex" bold
              text #n76 "You owe $300" size=s shade=mid
            text #n77 "$0" size=s
          row #n78 justify=between align=center
            col #n79 gap=1
              text #n80 "Jordan" bold
              text #n81 "You're owed $5.83" size=s shade=mid
            text #n82 "$5.83" size=s
          row #n83 justify=between align=center
            col #n84 gap=1
              text #n85 "Sam" bold
              text #n86 "You're owed $2.34" size=s shade=mid
            text #n87 "$2.34" size=s
      col #n88 gap=2
        button #n89 "Settle up" primary
    row #n91 h=56 pad=3 justify=between border
      text #n92 "Home" shade=mid size=s
      text #n93 "Expenses" shade=mid size=s
      text #n94 "People" bold size=s
      text #n95 "Settings" shade=mid size=s
  screen #n99 "Settings"
    row #n100 h=56 pad=2 border
      text #n101 "Settings" bold size=l
      col #n145 gap=2
        text #n146 "About" bold size=m
        text #n147 "SplitMate v2.1.0" shade=mid size=s
        text #n148 "Keep track of shared expenses with your roommates." shade=mid size=xs
    col #n102 grow pad=3 gap=4
      col #n103 gap=2
        text #n104 "Account" bold size=m
        col #n105 gap=2
          row #n106 justify=between align=center
            text #n107 "Email" size=m
            text #n108 "alex.chen@email.com" shade=mid size=s
          row #n109 justify=between align=center
            text #n110 "Phone" size=m
            text #n111 "+1 (555) 234-5678" shade=mid size=s
      col #n112 gap=2
        text #n113 "Preferences" bold size=m
        col #n114 gap=2
          row #n115 justify=between align=center
            text #n116 "Currency" size=m
            text #n117 "USD" shade=mid size=s
          row #n118 justify=between align=center
            text #n119 "Notifications" size=m
            input #n120 on toggle
      col #n121 gap=2
        text #n122 "Group" bold size=m
        col #n123 gap=2
          row #n124 justify=between align=center
            text #n125 "Group name" size=m
            text #n126 "Roommates" shade=mid size=s
          row #n127 justify=between align=center
            text #n128 "Members" size=m
            text #n129 "4 people" shade=mid size=s
      col #n130 gap=2
        button #n131 "Log out" ghost
        button #n132 "Delete account" ghost
    row #n133 h=56 pad=3 justify=between border
      text #n134 "Home" shade=mid size=s
      text #n135 "Expenses" shade=mid size=s
      text #n136 "People" shade=mid size=s
      text #n137 "Settings" bold size=s
