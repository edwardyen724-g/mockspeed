app #n1 "Mail" web
  screen #n2 "Inbox"
    row #n3 h=fill
      col #n4 share=nav w=200 fill=mid pad=3 gap=2
        text #n5 "Mail" bold size=l
        line #n6
        text #n7 "Inbox" bold
        text #n8 "Drafts" shade=mid
        text #n9 "Sent" shade=mid
        text #n10 "Trash" shade=mid
        line #n11
        text #n12 "Folders" shade=mid size=s
        text #n13 "Work" shade=mid
        text #n14 "Personal" shade=mid
        text #n15 "Archive" shade=mid
      col #n16 grow pad=3 gap=3
        button #n125 "Compose" primary
        row #n121 justify=between align=center
          text #n122 "Inbox" bold size=xxl
          row #n123 gap=2
            input #n124 "Search" search w=200
        row #n17 justify=between align=center
          text #n18 "Inbox" bold size=xl
          row #n19 gap=2
            input #n20 "Search" search w=200
            button #n21 "Compose" primary size=l
        col #n22 gap=2 grow
          table #n179
            tr #n180 "From | Subject | Time"
            tr #n181 "Sarah Chen | Re: Q4 Budget Review | 2:34 PM" data
            tr #n182 "Alex Martinez | Coffee tomorrow? | 1:12 PM" data
            tr #n183 "Design Team | New branding mockups attached | 11:47 AM" data
            tr #n184 "Jordan Lee | Meeting notes from standup | 9:23 AM" data
            tr #n185 "Finance | Expense report submission deadline | Yesterday" data
        row #n186 gap=2 align=center pad=2
          text #n187 "Filter" shade=mid size=s
          button #n188 "Unread" ghost size=s
          button #n189 "Has attachment" ghost size=s
          button #n190 "From work" ghost size=s
  screen #n53 "Message"
    row #n54 h=fill
      col #n55 share=nav w=200 fill=mid pad=3 gap=2
        text #n56 "Mail" bold size=l
        line #n57
        text #n58 "Inbox" shade=mid
        text #n59 "Drafts" shade=mid
        text #n60 "Sent" shade=mid
        text #n61 "Trash" shade=mid
        line #n62
        text #n63 "Folders" shade=mid size=s
        text #n64 "Work" shade=mid
        text #n65 "Personal" shade=mid
        text #n66 "Archive" shade=mid
      col #n67 grow pad=3 gap=3
        row #n68 justify=between align=center
          col #n69 grow
            text #n70 "Re: Q4 Budget Review" bold size=l
            row #n71 gap=2
              text #n72 "Sarah Chen" bold size=s
              text #n73 "sarah@company.com" shade=mid size=s
            text #n74 "Today at 2:34 PM" shade=mid size=s
          button #n75 "Archive" ghost
        line #n76
        col #n77 gap=3 grow
          col #n78 gap=2 pad=3 fill=light
            text #n79 "Sarah Chen" bold
            text #n80 "Thanks for sending over the initial estimates. I've reviewed them and have a few questions about the marketing allocation." size=m
            text #n81 "2:34 PM" shade=mid size=s
          col #n82 gap=2 pad=3 align=end
            col #n83 gap=2 pad=3 fill=mid
              text #n84 "Looks reasonable overall. Should we schedule a sync?" size=m
            text #n85 "3:01 PM" shade=mid size=s
          col #n86 gap=2 pad=3 fill=light
            text #n87 "Sarah Chen" bold
            text #n88 "Yes, I have time Thursday at 10am or Friday afternoon. Which works better?" size=m
            text #n89 "3:15 PM" shade=mid size=s
        row #n90 gap=2 pad=3 border
          input #n91 "Reply..." area grow
          button #n92 "Send" primary
  screen #n93 "Compose"
    row #n94 h=fill
      col #n95 share=nav w=200 fill=mid pad=3 gap=2
        text #n96 "Mail" bold size=l
        line #n97
        text #n98 "Inbox" shade=mid
        text #n99 "Drafts" shade=mid
        text #n100 "Sent" shade=mid
        text #n101 "Trash" shade=mid
        line #n102
        text #n103 "Folders" shade=mid size=s
        text #n104 "Work" shade=mid
        text #n105 "Personal" shade=mid
        text #n106 "Archive" shade=mid
      col #n107 grow pad=3 gap=2
        row #n108 justify=between
          text #n109 "New Message" bold size=l
          text #n110 "Draft saved" shade=mid size=s
        line #n111
        col #n112 gap=2
          input #n113 "To" value=alex@company.com
          input #n114 "Cc"
          input #n115 "Subject" value="Project kickoff"
          line #n116
          input #n117 "Message..." area h=300 grow
        row #n118 justify=end gap=2
          button #n119 "Discard" ghost
  screen #n126 "Settings"
    row #n127 h=fill
      col #n128 share=nav w=200 fill=mid pad=3 gap=2
        text #n129 "Mail" bold size=l
        line #n130
        text #n131 "Inbox" shade=mid
        text #n132 "Drafts" shade=mid
        text #n133 "Sent" shade=mid
        text #n134 "Trash" shade=mid
        line #n135
        text #n136 "Folders" shade=mid size=s
        text #n137 "Work" shade=mid
        text #n138 "Personal" shade=mid
        text #n139 "Archive" shade=mid
      col #n140 grow pad=3 gap=3
        text #n141 "Settings" bold size=xl
        col #n191 gap=2 pad=3 fill=light border
          text #n192 "Note" bold size=s shade=mid
          text #n193 "Changes to your settings are saved automatically." size=s shade=mid
        col #n142 gap=4
          col #n143 gap=2
            text #n144 "Account" bold size=m
            row #n145 justify=between align=center pad=2 border
              col #n146 gap=1
                text #n147 "Email Address" size=s shade=mid
                text #n148 "sarah.chen@company.com" bold
              text #n149 "Change" shade=mid size=s
            row #n150 justify=between align=center pad=2 border
              col #n151 gap=1
                text #n152 "Password" size=s shade=mid
                text #n153 "Last changed 3 months ago" shade=mid size=s
              text #n154 "Update" shade=mid size=s
          col #n155 gap=2
            text #n156 "Notifications" bold size=m
            row #n157 justify=between align=center pad=2 border
              text #n158 "Email notifications" bold
              input #n159 "" toggle on
            row #n160 justify=between align=center pad=2 border
              text #n161 "Desktop notifications" bold
              input #n162 "" toggle
            row #n163 justify=between align=center pad=2 border
              text #n164 "Digest emails" bold
              input #n165 "" toggle on
          col #n166 gap=2
            text #n167 "Display" bold size=m
            row #n168 justify=between align=center pad=2 border
              text #n169 "Theme"
              text #n170 "Light" shade=mid
            row #n171 justify=between align=center pad=2 border
              text #n172 "Text size"
              text #n173 "Standard" shade=mid
          col #n174 gap=2
            row #n175 justify=between pad=2
              text #n176 "Sign out" shade=mid
              button #n177 "Sign out" ghost
