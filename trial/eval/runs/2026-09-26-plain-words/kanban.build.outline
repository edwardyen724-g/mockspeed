app #n1 "Design Studio" web
  screen #n2 "Board"
    row #n3 h=fill
      col #n4 share=nav w=200 fill=light pad=3 gap=2
        text #n5 "Board" bold
        text #n6 "Team" shade=mid
        text #n7 "Archive" shade=mid
      col #n8 grow pad=4 gap=4
